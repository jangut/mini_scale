############################################
# .gitignore（通用工程忽略规则模板）
# 适用于：C++ / Qt / CMake / Python / 通用
############################################

############################
# 1. 操作系统文件
############################
.DS_Store
Thumbs.db
desktop.ini

############################
# 2. 日志 & 临时文件
############################
*.log
*.tmp
*.temp
*.cache
*.swp
*.swo
*~
*.orig
*.rej
.*.swp
*.flc
*.autosave
*.debug

############################
# 3. 编译产物（C/C++）
############################
*.o
*.obj
*.exe
*.out
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
*.ilk
*.pdb
*.idb
*.Debug
*.Release
*.res
*.rc
*.prl

############################
# 4. Qt 生成文件（重点）
############################
moc_*.cpp
ui_*.h
qrc_*.cpp
*.qm
*.moc
*_pch.h.cpp
*_resource.rc
*.app
Makefile*
/.qmake.cache
/.qmake.stash
**/.qmlls.ini

############################
# 5. CMake 生成文件
############################
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt
/build*/
/*/build/
build/
.build/

